# Apache vhost for the React frontend, reverse-proxying /api and friends to
# the real backend (demo1.ecuenta.online) so every request the browser makes
# stays same-origin with the frontend's own domain — no CORS involved.
#
# This is the ONE place ProxyPass/ProxyPassReverse/SSLProxyEngine can
# actually live. Confirmed this session, against a real Apache instance:
# those directives are flatly rejected inside .htaccess ("not allowed
# here"), no matter what — vhost/server config is the only legal context
# for them. That's the entire reason this file exists instead of trying to
# do this from dist/.htaccess.
#
# Replace YOUR-FRONTEND-DOMAIN and the two /path/to/... lines below with
# your real values. demo1.ecuenta.online is left as-is — that's the real,
# already-hosted backend from src/api/backends.ts, not a placeholder.
#
# Prerequisites (ask whoever manages httpd.conf on this server to confirm/
# enable, if not already on — most real hosts already have these since they
# serve HTTPS traffic themselves for other reasons):
#   LoadModule proxy_module modules/mod_proxy.so
#   LoadModule proxy_http_module modules/mod_proxy_http.so
#   LoadModule ssl_module modules/mod_ssl.so
#   LoadModule rewrite_module modules/mod_rewrite.so

<VirtualHost *:443>
    ServerName YOUR-FRONTEND-DOMAIN

    # Point this at wherever you copy this repo's `dist/` output to.
    DocumentRoot "/path/to/ecuentafrontend-v1/dist"

    <Directory "/path/to/ecuentafrontend-v1/dist">
        Options -Indexes +FollowSymLinks
        # Lets dist/.htaccess (auto-generated by `npm run build` — see
        # vite.config.ts) apply its React Router SPA-fallback rewrite. The
        # backend-owned paths below are excluded from that fallback
        # already, so they don't conflict with the ProxyPass rules here.
        AllowOverride All
        Require all granted
    </Directory>

    # --- Reverse proxy to the real backend ---
    SSLProxyEngine On
    ProxyPreserveHost Off

    ProxyPass        /api https://demo1.ecuenta.online/api
    ProxyPassReverse /api https://demo1.ecuenta.online/api

    ProxyPass        /custom https://demo1.ecuenta.online/custom
    ProxyPassReverse /custom https://demo1.ecuenta.online/custom

    ProxyPass        /takeposnew https://demo1.ecuenta.online/takeposnew
    ProxyPassReverse /takeposnew https://demo1.ecuenta.online/takeposnew

    ProxyPass        /takepos https://demo1.ecuenta.online/takepos
    ProxyPassReverse /takepos https://demo1.ecuenta.online/takepos

    ProxyPass        /index.php https://demo1.ecuenta.online/index.php
    ProxyPassReverse /index.php https://demo1.ecuenta.online/index.php

    # --- TLS for the frontend's own domain (separate cert from demo1's —
    #     e.g. Let's Encrypt for YOUR-FRONTEND-DOMAIN) ---
    SSLEngine On
    SSLCertificateFile     "/path/to/YOUR-FRONTEND-DOMAIN-cert.pem"
    SSLCertificateKeyFile  "/path/to/YOUR-FRONTEND-DOMAIN-key.pem"
    # SSLCertificateChainFile "/path/to/chain.pem"   # only if your CA needs one

    ErrorLog  "logs/frontend-error.log"
    CustomLog "logs/frontend-access.log" combined
</VirtualHost>

# Plain-HTTP requests get bounced to HTTPS rather than served insecurely.
<VirtualHost *:80>
    ServerName YOUR-FRONTEND-DOMAIN
    Redirect permanent / https://YOUR-FRONTEND-DOMAIN/
</VirtualHost>
