# Copy this file to .env.local (gitignored — per developer/machine, not
# committed) and set which backend the dev proxy and app talk to.
#
# Valid values: local | demoV2 | demo1 | live
# See src/api/backends.ts's BACKEND_URLS for what each one points at.
# Falls back to backends.ts's DEFAULT_BACKEND if unset.
#
# Vite's dev proxy config isn't hot-reloadable — restart `npm run dev`
# after changing this.
#
# Production builds (`npm run build`) read the committed .env.production
# instead (which takes priority over this file — see its own comment), so
# changing this file only ever affects your own local dev server.
VITE_ACTIVE_BACKEND=demo1
